{
  "name": "@5of12/webxr-webcam-hands",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "description": "Development-only webcam hand input through MediaPipe and IWER",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run tests/landmarks.test.ts",
    "test:browser": "playwright test",
    "build": "vite build && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "iwer": "2.5.0",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/three": "^0.181.0",
    "@types/webxr": "^0.5.24",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  },
  "overrides": {
    "three": "npm:super-three@0.181.0"
  }
}
